---
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
---

<!DOCTYPE html>
<html>
  <Header title="Contacto | Sam Bernstein" />
  <body>
    <div class="content">
      <Sidebar selectedItem="contacto" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block"
              ><img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back</div></a
            >
          </div>
          <div class="content-container">
            <h1>Contacto</h1>
            <p class="lead">
              ¿Tienes un proyecto o idea en mente? Completa el formulario para compartir los detalles y me pondré en contacto contigo.
            </p>
            <section class="items-container">
              <div class="contact-card">
                <form class="contact-form">
                  <label class="form-label" for="name">Nombre</label>
                  <input id="name" name="name" type="text" class="text-field w-input" placeholder="Tu nombre" required />

                  <label class="form-label" for="email">Email</label>
                  <input id="email" name="email" type="email" class="text-field w-input" placeholder="tu@email.com" required />

                  <label class="form-label" for="message">Mensaje</label>
                  <textarea
                    id="message"
                    name="message"
                    class="text-field w-input"
                    placeholder="Cuéntame sobre tu proyecto"
                    rows="5"
                    required
                  ></textarea>

                  <button type="submit" class="button w-button">Enviar</button>
                </form>
              </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>