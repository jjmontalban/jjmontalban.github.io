---
import Header from "../components/Header.astro";
import Project from "../components/Project.astro";
import Sidebar from "../components/Sidebar.astro";
import { getCollection } from "astro:content";

const casos = (await getCollection("casos")).sort((a, b) => a.data.order - b.data.order);
---

<!DOCTYPE html>
<html>
  <Header title="Casos de Éxito | JJ Montalban" />
  <body>
    <div class="content">
      <Sidebar selectedItem="casos" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/" class="back-nav-button w-inline-block">
              <img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Volver</div>
            </a>
          </div>

          <div class="content-container">
            <h1>Casos de éxito</h1>

            <section class="items-container">
              <div class="resouce-items">
                {casos.map(({ slug, data }) => (
                  <a href={`/casos/${slug}`} class="project-link">
                    <Project
                      title={data.title}
                      desc={data.desc}
                      tech={data.tech}
                      showLink={false}
                    />
                  </a>
                ))}
              </div>
            </section>

          </div>
        </div>
      </nav>
    </div>
  </body>
</html>
