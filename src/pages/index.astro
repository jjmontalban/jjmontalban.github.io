---
import Header from "../components/Header.astro";
import Project from "../components/Project.astro";
import Sidebar from "../components/Sidebar.astro";
---

<!DOCTYPE html>
<html>
  <Header title="Sam Bernstein" />
  <body>
    <div class="content">
      <Sidebar selectedItem="home" />
      <nav class="main">
        <div class="container">
          <main class="fold-content-container">
            <div class="fold-content">
              <h1 class="intro-text">Desarrollo WordPress especializado para mejorar lo que ya tienes.</h1>
              <p class="lead">Funcionalidades a medida, rendimiento, seguridad e integraciones sin necesidad de rehacer tu web desde cero.</p>
            </div>
            <a class="button w-button" href="/contacto">Hablemos de tu proyecto</a>
          </main>

          <div class="content-container">
            <section class="items-container">
              <h3>Plugins WordPress a medida</h3>
              <p class="project-desc">
                Diseño e implemento funcionalidades específicas que complementan tu WordPress actual sin sustituir tu tema ni tus plugins.
                Código limpio, mantenible y alineado con las buenas prácticas del ecosistema WordPress.
              </p>
            </section>

            <section class="items-container">
              <h3>Mejoras sobre tu WordPress actual</h3>
              <p class="project-desc">No necesitas reconstruir tu sitio. Puedo adaptar y ampliar lo que ya tienes para que tu negocio pueda crecer sin fricciones técnicas.</p>
            </section>

            <section class="items-container">
              <h3>Integraciones y automatización</h3>
              <p class="project-desc">Conexiones con APIs externas, CRMs, plataformas inmobiliarias como Pisos.com, sincronización de datos y automatización de procesos.</p>
            </section>

            <section class="items-container">
              <h3>Rendimiento y seguridad</h3>
              <p class="project-desc">Optimización WPO, estabilización técnica, configuraciones CSP, mitigación de vulnerabilidades y mejoras orientadas a la fiabilidad.</p>
            </section>

            <section class="items-container">
              <h2>Por qué trabajar conmigo</h2>
              <div class="case-detail-section">
                <p class="project-desc">
                  Soy un desarrollador WordPress freelance con experiencia en proyectos corporativos, integraciones complejas y portales con necesidades técnicas avanzadas.
                </p>
                <p class="project-desc">Trabajo de forma incremental: mejoro tu plataforma actual sin obligarte a rehacerla desde cero.</p>
                <p class="project-desc">Mi enfoque combina desarrollo a medida, rendimiento, seguridad y escalabilidad.</p>
                <p class="project-desc">Comunicación directa, entregas rápidas y soluciones pensadas para durar.</p>
              </div>
            </section>

            <section class="items-container">
              <h2>Plugins destacados</h2>
              <div class="case-detail-section">
                <p class="project-desc">
                  He publicado diversos plugins que aportan soluciones reales a problemas habituales de WordPress. Son una muestra de mi enfoque en estabilidad, rendimiento y control.
                </p>
                <a class="button w-button" href="/plugins">Ver plugins publicados</a>
              </div>
            </section>

            <section class="items-container">
              <h2>Casos de éxito</h2>
              <div class="case-detail-section">
                <p class="project-desc">
                  He trabajado en integraciones técnicas, portales corporativos y desarrollos especializados para WordPress. Puedes ver resultados reales aquí.
                </p>
                <a class="button" href="/casos">Ver casos</a>
              </div>
            </section>

            <section id="contact" class="items-container">
              <div class="case-detail-section">
                <p class="project-desc">¿Quieres mejorar tu WordPress sin rehacerlo desde cero?</p>
                <a class="button w-button" href="/contacto">Hablemos</a>
              </div>
            </section>
          </div>
        </div>
      </nav>
    </div>

    <!--[if lte IE 9]><script src="//cdnjs.cloudflare.com/ajax/libs/placeholders/3.0.2/placeholders.min.js"></script><![endif]-->
  </body>
</html>
