---
const { selectedItem } = Astro.props;
---

<nav class="navbar">
  <div class="nav-content">
    <a href="/" class="nav-brand" aria-label="home">
      <div class="niv-data">
        <img
          src="/assets/jj.png"
          loading="eager"
          alt="Profile picture"
          class="niv-image"
        />
        <div>
          <div class="label-white">JJ Montalban</div>
          <div class="label-gray">Software Engineer</div>
        </div>
      </div>
    </a>

    <div class="nav-links">
      <a
        href="/"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'home' ? 'w--current' : ''
        }`}
      >
        <img
          src="/assets/home.svg"
          loading="eager"
          alt=""
          class="nav-link-image"
        />
        <div>Home</div>
      </a>
      <a
        href="/casos"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'casos' ? 'w--current' : ''
        }`}
        aria-current={
          selectedItem === 'casos' ? 'page' : undefined
        }
      >
        <img
          src="/assets/code.svg"
          loading="eager"
          alt=""
          class="nav-link-image"
        />
        <div>Casos de éxito</div>
      </a>
      <a
        href="/plugins"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'plugins' ? 'w--current' : ''
        }`}
      >
        <img
          src="/assets/dns.svg"
          loading="eager"
          alt=""
          class="nav-link-image"
        />
        <div>Plugins publicados</div>
      </a>
      <a
        href="/contacto"
        class={`nav-link-container w-inline-block ${
          selectedItem === 'contacto' ? 'w--current' : ''
        }`}
      >
        <img
          src="/assets/favorite.svg"
          loading="eager"
          alt=""
          class="nav-link-image"
        />
        <div>Contacto</div>
      </a>
    </div>
  </div>
</nav>
